# OmniGateway Backend Environment Variables
# Copy this file to .env and fill in the values

# 32-character random secret for AES-256-CBC encryption of user API keys
# Generate with: openssl rand -hex 16
ENCRYPTION_SECRET=your_32_character_random_secret_here

# Server port
PORT=4000

# Frontend URL for CORS (update to your Vercel URL after deploy)
FRONTEND_URL=http://localhost:5173

# Optional: Distributed Redis URL (e.g. redis://localhost:6379 or rediss://default:pass@redis.upstash.io:6379)
# Leave blank to run in Standalone In-Memory mode. If set, enables distributed L1 cache and atomic Lua rate limits across pods.
# REDIS_URL=redis://localhost:6379
